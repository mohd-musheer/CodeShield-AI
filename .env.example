# ==============================================================================
# CodeShield AI Configuration Template
# Copy this file to '.env' and fill in your custom values.
# ==============================================================================

# [Mandatory] Groq LLM API Credentials
# Retrieve your API Key from: https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# [Optional] Groq LLM Model Configuration
# Supported models: llama-3-70b-8192, llama-3-8b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3-70b-8192

# [Optional] Server Deployment Configuration
# Bind interface host (0.0.0.0 exposes the API to external requests)
HOST=127.0.0.1
PORT=8000

# [Optional] Debugging and Logging Levels
# Set DEBUG to true to enable detail logs and automatic reloading (dev modes only)
DEBUG=false
LOG_LEVEL=INFO


